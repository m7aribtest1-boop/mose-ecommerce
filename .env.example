# ===== قاعدة البيانات (PostgreSQL / Neon) =====
# الإنتاج (Vercel + Neon): الربط يُحقن تلقائياً كـ mosa_DATABASE_URL_UNPOOLED
# (لا تضع له هنا أي قيمة في الإنتاج — متغيرات Vercel تتولى ذلك).
# محلياً: بدّل provider في prisma/schema.prisma إلى sqlite واستعمل:
#   mosa_DATABASE_URL_UNPOOLED="file:./prisma/dev.db"
# أو استعمل PostgreSQL محلياً:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mose?schema=public"
mosa_DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/mose?schema=public"

# ===== أمان =====
# يستعمل لتوقيع "تحدي 2FA" في /api/admin/login.
# في الإنتاج استعمل قيمة عشوائية طويلة:  openssl rand -base64 32
MOSE_SESSION_SECRET="change-me-64-characters-random-string"

# ===== إعدادات عامة =====
NEXT_PUBLIC_SITE_NAME="موسى"
# رقم واتساب التجاري يُقرأ من إعدادات المتجر (لوحة التحكم /admin) —
# القيمة الافتراضية فـ src/lib/store.ts هي 212600000000.